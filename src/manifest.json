{
  "manifest_version": 3,
  "name": "Minecraft 新标签页",
  "short_name": "MC New Tab",
  "version": "1.0.0",
  "description": "Minecraft 风格的启动页与新标签页：壁纸、搜索、小组件物品栏。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "identity"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "author": "43086FG",
  "homepage_url": "https://github.com/43086FG/CraftTab",
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "texts/*", "packs/*", "css/*", "js/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  }
}
